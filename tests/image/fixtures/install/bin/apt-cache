printf 'apt-cache %s\n' "$*" >>"$FAKE_LOG"
if [ "${1:-}" = policy ] && [ "${2:-}" = cmake ]; then
    printf 'cmake:\n  Installed: (none)\n  Candidate: %s\n  Version table:\n' "${FAKE_APT_CANDIDATE:-(none)}"
fi
